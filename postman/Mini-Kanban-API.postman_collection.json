{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Mini Kanban Board API",
    "description": "Webbriks Mini Kanban — Express API collection.\n\nHow to use:\n1. Import this file into Postman.\n2. Set `baseUrl` (default http://localhost:5000/api).\n3. Run Auth → Register or Login (token is saved automatically).\n4. Run Boards → Create Board (boardId + first columnId are saved).\n5. Continue with tasks / move / share.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "boardId", "value": "" },
    { "key": "columnId", "value": "" },
    { "key": "targetColumnId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "memberUserId", "value": "" },
    { "key": "memberEmail", "value": "teammate@example.com" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Tester\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "List Boards",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/boards"
          }
        },
        {
          "name": "Create Board",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  const board = json.data;",
                  "  if (board && board.id) {",
                  "    pm.collectionVariables.set('boardId', board.id);",
                  "  }",
                  "  if (board && board.columns && board.columns.length > 0) {",
                  "    pm.collectionVariables.set('columnId', board.columns[0].id);",
                  "    if (board.columns.length > 1) {",
                  "      pm.collectionVariables.set('targetColumnId', board.columns[1].id);",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint Board\"\n}"
            },
            "url": "{{baseUrl}}/boards"
          }
        },
        {
          "name": "Get Board By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const board = pm.response.json().data;",
                  "  if (board && board.columns && board.columns.length > 0) {",
                  "    pm.collectionVariables.set('columnId', board.columns[0].id);",
                  "    if (board.columns.length > 1) {",
                  "      pm.collectionVariables.set('targetColumnId', board.columns[1].id);",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/boards/{{boardId}}"
          }
        },
        {
          "name": "Update Board",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint Board Updated\"\n}"
            },
            "url": "{{baseUrl}}/boards/{{boardId}}"
          }
        },
        {
          "name": "Delete Board",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/boards/{{boardId}}"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Add Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/boards/{{boardId}}/members",
            "description": "memberEmail must be a registered user (register a second user first)."
          }
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/boards/{{boardId}}/members/{{memberUserId}}",
            "description": "Set memberUserId from Add Member response (data.user.id)."
          }
        }
      ]
    },
    {
      "name": "Columns",
      "item": [
        {
          "name": "Create Column",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const col = pm.response.json().data;",
                  "  if (col && col.id) {",
                  "    pm.collectionVariables.set('columnId', col.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Review\"\n}"
            },
            "url": "{{baseUrl}}/boards/{{boardId}}/columns"
          }
        },
        {
          "name": "Update Column",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"In Review\"\n}"
            },
            "url": "{{baseUrl}}/columns/{{columnId}}"
          }
        },
        {
          "name": "Delete Column",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/columns/{{columnId}}"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const task = pm.response.json().data;",
                  "  if (task && task.id) {",
                  "    pm.collectionVariables.set('taskId', task.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement move API\",\n  \"description\": \"Reorder within column and move across columns\"\n}"
            },
            "url": "{{baseUrl}}/columns/{{columnId}}/tasks"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement move API (updated)\",\n  \"description\": \"With Prisma transaction\"\n}"
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Move Task",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetColumnId\": \"{{targetColumnId}}\",\n  \"targetPosition\": 0\n}"
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}/move",
            "description": "Reorders within a column or moves across columns. targetColumnId is set when you Create/Get Board (2nd default column)."
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        }
      ]
    }
  ]
}
